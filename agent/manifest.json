{
  "name": "filmcraft-web",
  "version": "0.17.0",
  "build": "web.18",
  "built": "2026-11-03",
  "url": "https://elzuzu.github.io/filmcraft-web-app/",
  "description": "FilmCraft non-linear video editor running in the browser via WebAssembly, WebGPU/WebGL2.",
  "upstream": {
    "repository": "https://github.com/storytold/filmcraft",
    "commit": "32749e34f611735460e9773335345db026b7b037",
    "license": "MIT OR Apache-2.0"
  },
  "source": {
    "public": false,
    "repository": "filmcraft-agent",
    "access": "on request"
  },
  "renderers": [
    "webgpu",
    "webgl2"
  ],
  "commands": 716,
  "time": {
    "ticksPerSecond": 254016000000
  },
  "api": {
    "global": "window.filmcraft",
    "methods": [
      "execute",
      "request",
      "commands",
      "inspect",
      "info",
      "screenshot",
      "files",
      "readFile",
      "importFiles",
      "importUrl",
      "openProject",
      "readFileChunk",
      "registerFile",
      "releaseExport",
      "createPackage",
      "openPackage"
    ],
    "docs": "AGENTS.md"
  },
  "agent": {
    "manifest": "agent/manifest.json",
    "guide": "llms.txt",
    "skill": "filmcraft-web",
    "mcp": {
      "available": true,
      "transport": "stdio",
      "repository": "filmcraft-agent",
      "tools": [
        "filmcraft_open",
        "filmcraft_status",
        "filmcraft_commands",
        "filmcraft_execute",
        "filmcraft_request",
        "filmcraft_inspect",
        "filmcraft_screenshot",
        "filmcraft_import",
        "filmcraft_export",
        "filmcraft_render",
        "filmcraft_save",
        "filmcraft_click",
        "filmcraft_key",
        "filmcraft_type",
        "filmcraft_close",
        "filmcraft_open_project",
        "filmcraft_relink",
        "filmcraft_attach_proxy",
        "filmcraft_files",
        "filmcraft_release_export",
        "filmcraft_package_project",
        "filmcraft_open_package"
      ]
    }
  },
  "media": {
    "sample": "samples/ocean-sunset.mp4",
    "procedural": true
  },
  "license": "MIT OR Apache-2.0",
  "proxy": {
    "cooperative": true,
    "aggregateJob": true,
    "supportsCancellation": true,
    "virtualDestination": "/exports/Proxies",
    "notes": "Inspect child jobs for partial failures; wait:true is unsupported. Completed files consume browser memory.",
    "encoderQueue": "one at a time"
  },
  "maskTracking": {
    "cooperative": true,
    "supportsWait": false,
    "supportsCancellation": true,
    "notes": "Pending media reads are retried. Project edits or replacement stop tracking; completed keyframes are retained."
  },
  "exportRelease": {
    "scope": "exact /exports/ in-memory files",
    "explicit": true,
    "note": "Save files before releasing; active readers may retain memory and attached proxies may become unavailable."
  },
  "videoPreviews": {
    "cooperative": true,
    "sessionOnly": true,
    "retainedEncodedBytesMax": 268435456,
    "supportsWait": false,
    "playback": true,
    "notes": "Temporary rendering memory may exceed the shared audio/video cache budget."
  },
  "audioPreviews": {
    "cooperative": true,
    "sessionOnly": true,
    "sharesVideoCache": true,
    "supportsWait": false,
    "playback": true,
    "notes": "Nested-sequence DSP with deferred reads has not been independently verified."
  },
  "audioOutput": {
    "preferred": "AudioWorklet",
    "fallback": "ScriptProcessor",
    "fallbackTimeoutMs": 2000,
    "statusField": "audioBackend",
    "notes": "Fallback runs on the main thread and may underrun under load; a user gesture may be required."
  },
  "portableProject": {
    "extension": "fcpack",
    "checksums": "SHA-256",
    "contains": [
      "project",
      "linked media",
      "proxies",
      "numbered image sequences"
    ],
    "limitations": [
      "transcoding"
    ],
    "encrypted": false,
    "signed": false,
    "maxAssets": 10000,
    "maxImageAliases": 10000,
    "notes": "Sequences preserve gaps and isolate names. Each still-image read is limited to 256 MiB. Optional previews share a 256 MiB cache budget; older builds reject version 2 packages.",
    "selection": {
      "excludeUnusedDefault": false,
      "sequences": "existing sequence IDs; used for filtering when excludeUnused is true",
      "includeProxiesDefault": true,
      "nestedDependencies": true,
      "includePreviewsDefault": false
    },
    "previewPackageVersion": 2
  },
  "exportMemory": {
    "storage": "JavaScript blocks and final Blob",
    "boundedMemory": false,
    "notes": "Seekable encoded exports avoid one growing WebAssembly buffer; browser memory is still used and Blob construction may copy. PNG and GIF use the existing path."
  }
}
